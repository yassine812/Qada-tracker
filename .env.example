# No secret/API key is required for guest/offline Qada. VITE_* values are public.
# Optional account backend. Use only the PUBLIC publishable key, never service_role.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional production HTTPS origin used for canonical links and sitemap.
SITE_URL=https://qada-tracker-five.vercel.app

# Publisher ID alone can generate verification metadata + ads.txt without ads.
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_GUIDE_SLOT=

# Keep false until approval AND independently loaded certified CMP are verified.
VITE_ADS_ENABLED=false
VITE_ADSENSE_APPROVED=false
VITE_PUBLISHER_NAME=
VITE_CONTACT_EMAIL=

# Public URL only, e.g. https://your-vercel-project.vercel.app/api/notifications.
# Leave empty when the API is available at the same origin.
VITE_PUSH_API_URL=

# SERVER ONLY: configure in Vercel, never prefix with VITE_ or put in public/.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:zerniyassine21@gmail.com
CRON_SECRET=
PUSH_ALLOWED_ORIGINS=https://qada-tracker-five.vercel.app,https://qada-tracker-yassine.netlify.app

