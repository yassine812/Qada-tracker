{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && node scripts/prepare-public-site.mjs && node scripts/build-service-worker.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "node --test scripts/test-offline-worker.mjs scripts/test-advertising.mjs scripts/test-public-build.mjs scripts/test-install.mjs",
    "ios:sync": "npm run build && cap sync ios && npm run ios:verify",
    "ios:verify": "node scripts/verify-ios-bundle.mjs",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "8.5.1",
    "@capacitor/ios": "8.5.1",
    "@fontsource/amiri": "5.3.0",
    "@fontsource/amiri-quran": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@fontsource/noto-sans-arabic": "5.3.0",
    "@fontsource/scheherazade-new": "5.3.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "^5.0.4",
    "adhan": "^4.4.6",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
